# Copy this file to .env and fill in the values.
# cp .env.example .env

# ── Required ──────────────────────────────────────────────────────────────────

# JWT signing key — MUST be at least 32 characters.
# Generate with:  openssl rand -hex 32
SECRET_KEY=your-secret-key-here-min-32-chars

# Anthropic Claude API key — get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-...

# ── Optional (shown with defaults) ───────────────────────────────────────────

# "development" enables extra CORS origins (localhost variants + "null").
# Set to "production" and configure ALLOWED_ORIGINS for real deployments.
APP_ENV=development

# In production, set this to your actual domain(s) as a JSON array:
# ALLOWED_ORIGINS=["https://your-domain.com"]
# ALLOWED_ORIGINS=

DATABASE_URL=sqlite:///./rag.db
ACCESS_TOKEN_EXPIRE_MINUTES=60
CHROMA_PERSIST_DIR=./chroma_data
UPLOAD_DIR=./uploads
TOP_K=5
